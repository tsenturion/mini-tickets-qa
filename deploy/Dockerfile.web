# Отдельная поставка UI: тот же код и локаторы, другой процесс и сетевой путь до API.
FROM node:24.11.1-alpine@sha256:682368d8253e0c3364b803956085c456a612d738bd635926d73fa24db3ce53d7 AS frontend
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_DEFECTS=none
ENV VITE_DEFECTS=$VITE_DEFECTS
RUN npm run build

FROM nginx:1.28.0-alpine@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284
COPY --from=frontend /build/dist /usr/share/nginx/html
COPY contract/openapi.json /usr/share/nginx/html/openapi.json
# Объединённый контракт нужен микросервисам, каждый из которых знает лишь своё API.
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
