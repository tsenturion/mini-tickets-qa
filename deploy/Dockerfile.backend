# Общая среда FastAPI для вариантов, в которых интерфейс поставляется отдельным веб-сервисом.
FROM python:3.13-slim@sha256:eb43ff125d8d58d7449dcba7d336c23bcac412f526d861db493b9994d8010280 AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt requirements.lock ./
RUN pip install --no-cache-dir -r requirements.txt -c requirements.lock
COPY backend/ backend/
COPY migrations/ migrations/
COPY alembic.ini ./
RUN useradd --uid 10001 --create-home lab && mkdir -p /app/logs && chown -R lab:lab /app
USER lab
EXPOSE 8000

FROM runtime AS application
ENV SERVICE=all LOG_DIR=/app/logs
CMD ["sh", "-c", "alembic upgrade head && python -m backend.seed && uvicorn backend.main:app --host 0.0.0.0 --port 8000 --no-access-log"]

FROM runtime AS identity
ENV SERVICE=identity LOG_DIR=/app/logs/identity
CMD ["sh", "-c", "alembic upgrade head && python -m backend.seed && uvicorn backend.main:app --host 0.0.0.0 --port 8000 --no-access-log"]

FROM runtime AS tickets
ENV SERVICE=tickets LOG_DIR=/app/logs/tickets
CMD ["sh", "-c", "alembic upgrade head && python -m backend.seed && uvicorn backend.main:app --host 0.0.0.0 --port 8000 --no-access-log"]
